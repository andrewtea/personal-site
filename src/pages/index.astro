---
// The forum index: the profile and who's online stack in a left rail; the main column flows
// the about panel, the threads, and the library shelf. The panels keep their anchor ids
// (about, library) for the links that jump straight to them.
import { getCollection } from "astro:content";
import Forum from "../layouts/Forum.astro";
import Postbit from "../components/Postbit.astro";
import { postDate } from "../format";
import { coversFor } from "../covers";

const posts = (await getCollection("writing", ({ data }) => import.meta.env.DEV || !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const books = (await getCollection("library", ({ data }) => import.meta.env.DEV || !data.draft)).sort((a, b) => a.data.title.localeCompare(b.data.title));
const covers = await coversFor(books.flatMap(({ data }) => (data.isbn ? [data.isbn] : [])));
const JIMMY_LINKEDIN = "https://www.linkedin.com/in/jimmy-yao/";
---
<Forum title="andrew" description="andrew — building voluma, prev epic.">
  <aside class="rail">
    <section class="panel me">
      <div class="bar"><h1>profile</h1>
        <span class="contact">
          <a target="_blank" rel="noopener noreferrer" href="https://github.com/andrewtea" aria-label="github" title="github"><img src="/assets/icons/github.svg" alt="" width="16" height="16"></a>
          <a target="_blank" rel="noopener noreferrer" href="https://x.com/andrewDotTea" aria-label="twitter" title="twitter"><img src="/assets/icons/twitter.svg" alt="" width="16" height="16"></a>
          <a target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/andrewtea" aria-label="linkedin" title="linkedin"><img src="/assets/icons/linkedin.svg" alt="" width="16" height="16"></a>
          <a href="mailto:andrew@voluma.bio" aria-label="email" title="email"><img src="/assets/icons/mail.svg" alt="" width="16" height="16"></a>
        </span>
      </div>
      <div class="body profile">
        <Postbit contact={false} />
        <div>
          <div class="row">
            <span class="label">building</span>
            <span><a target="_blank" rel="noopener noreferrer" class="gel company voluma" href="https://voluma.bio/" aria-label="voluma"><img src="/assets/voluma-wordmark.png" alt="" width="320" height="53"></a></span>
          </div>
          <div class="row">
            <span class="label">prev</span>
            <span><a target="_blank" rel="noopener noreferrer" class="gel company epic" href="https://www.epic.com/" aria-label="epic"><img src="/assets/epic-wordmark.png" alt="" width="106" height="41"></a>
              <a target="_blank" rel="noopener noreferrer" class="gel company intel" href="https://www.intel.com/" aria-label="intel"><img src="/assets/intel-wordmark.png" alt="" width="206" height="80"></a></span>
          </div>
        </div>
      </div>
    </section>

    <section class="panel side">
      <div class="bar"><h2>who's online</h2></div>
      <div class="body online">
        <p id="online-count" aria-live="polite">1 member online</p>
        <p class="members"><span class="status admin" title="administrator">andrew</span></p>
      </div>
    </section>
  </aside>

  <section class="panel about" id="about" aria-label="about">
    <div class="bar"><h1>about</h1></div>
    <div class="body">
      <p class="aboutme">For the past 3 years, I was at Epic Systems building clinical AI for wound care nurses.<br>I left Epic to build Voluma with my good friend <a target="_blank" rel="noopener noreferrer" class="person" href={JIMMY_LINKEDIN}><img src="/assets/icons/linkedin.svg" alt="" width="14" height="14">Jimmy</a>, where we’re accelerating preclinical efficacy studies for drug development.</p>
    </div>
  </section>

  <section class="panel threads" aria-label="writing">
    <table>
      <thead><tr><th>thread</th><th class="last">last post</th></tr></thead>
      <tbody>
        {posts.length === 0 && <tr><td>nothing here yet.</td><td class="last">—</td></tr>}
        {posts.map((post) => (
          <tr>
            <td><a class="title" href={`/writing/${post.id}/`}>{post.data.title}</a><span class="by">started by andrew</span></td>
            <td class="last">{postDate(post.data.date)}<span class="by">by andrew</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="panel books" id="library" aria-label="library">
    <div class="bar"><h1>library</h1></div>
    <div class="body shelf">
      {books.map(({ data }) => {
        const cover = data.isbn ? covers.get(data.isbn) : undefined;
        const href = data.isbn ? `https://openlibrary.org/isbn/${data.isbn}` : undefined;
        return (
          <div class="book">
            {cover
              ? <a class="avatar-link" href={href} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><img class="cover" src={cover} alt="" loading="lazy"></a>
              : <span class="cover empty"><img src="/assets/icons/library.svg" alt="" width="16" height="16"></span>}
            {href
              ? <a class="title" target="_blank" rel="noopener noreferrer" href={href}>{data.title}</a>
              : <span class="title">{data.title}</span>}
            <span class="by">by {data.author}</span>
            {data.note && <span class="note">{data.note}</span>}
          </div>
        );
      })}
      {books.length === 0 && <p>nothing on the shelf yet.</p>}
    </div>
  </section>
</Forum>
